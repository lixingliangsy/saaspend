]

const faqs = [
  {
    "question": "What is SaaSpend — and when to use it",
    "answer": "SaaSpend is a SaaS spend audit tool that lists your team's subscriptions and flags duplicate categories, forgotten tools, and a suggested savings number. Reach for it when your tool sprawl grows past what one spreadsheet can track."
  },
  {
    "question": "How to run a SaaS spend audit in 10 minutes",
    "answer": "A step-by-step for a first SaaS spend audit using SaaSpend: paste your tools with monthly costs, review the duplicate-category flags, and read the suggested savings. The savings figure is an estimate, not a guaranteed amount."
  },
  {
    "question": "Common SaaS spend audit mistakes (and how to avoid them)",
    "answer": "5 recurring errors teams make in a SaaS spend audit, with fixes: missing annual tools, lumping unrelated apps, ignoring seat counts, skipping forgotten trials, and not re-auditing quarterly."
